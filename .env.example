# ============================================================
# eOffice Chatbot – biến môi trường dùng chung
# ============================================================

# --- SQL Server (Docker) ---
# Tối thiểu 8 ký tự, có hoa, thường, số, ký tự đặc biệt
MSSQL_SA_PASSWORD=ChangeMe_Strong#2026
MSSQL_PORT=1433

# --- Connection string (.NET đọc dạng ConnectionStrings__<Tên>) ---
ConnectionStrings__EOfficeMockDb=Server=localhost,1433;Database=EOfficeMockDb;User Id=sa;Password=<MSSQL_SA_PASSWORD>;TrustServerCertificate=True
ConnectionStrings__ChatbotDb=Server=localhost,1433;Database=ChatbotDb;User Id=sa;Password=<MSSQL_SA_PASSWORD>;TrustServerCertificate=True

# --- JWT (HS256, khóa chung cho eOffice Mock, Chatbot Backend, AI Service) ---
JWT_KEY=<chuỗi ngẫu nhiên ≥ 32 ký tự>
JWT_ISSUER=eoffice-mock
JWT_AUDIENCE=eoffice-chatbot
JWT_EXPIRES_MIN=60

# --- URL các service (dev) ---
FRONTEND_URL=http://localhost:4200
CHATBOT_BACKEND_URL=http://localhost:5100
EOFFICE_MOCK_URL=http://localhost:5200
AI_SERVICE_URL=http://localhost:8001

# --- Ollama (chạy trên máy, ngoài Docker) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen2.5:3b
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# --- Langfuse Cloud ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Cờ AI Service ---
USE_MOCK=true
ENABLE_WRITE_TOOLS=false